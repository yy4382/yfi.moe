---
import * as stylex from "@stylexjs/stylex";
import { styles } from "../components/probe.stylex";
import Counter from "../components/counter";
import "../probe.css";
---

<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width"
    /><title>StyleX Astro probe</title>{
      import.meta.env.DEV && (
        <link rel="stylesheet" href="/virtual:stylex.css" />
      )
    }</head
  >
  <body
    ><main {...stylex.attrs(styles.card)}>
      <h1>Astro StyleX</h1><Counter client:load />
    </main><script>
      if (import.meta.env.DEV) import("virtual:stylex:css-only");
    </script></body
  >
</html>
