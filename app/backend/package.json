{
  "name": "@repo/backend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "email:dev": "pnpx react-email dev --dir src",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/standard-validator": "^0.4.0",
    "@libsql/client": "^0.18.0",
    "@repo/api": "workspace:*",
    "@repo/guest-identity": "workspace:*",
    "@repo/helpers": "workspace:*",
    "@repo/markdown": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.13",
    "@standard-community/standard-json": "^0.3.6",
    "@standard-community/standard-openapi": "^0.2.10",
    "@vitest/coverage-v8": "^5.0.5",
    "akismet-api": "^6.0.0",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "fp-ts": "^2.16.11",
    "hono": "catalog:",
    "hono-openapi": "^1.3.5",
    "hono-pino": "^0.10.3",
    "nodemailer": "^10.1.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "catalog:",
    "react-email": "^6.11.3",
    "spark-md5": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/json-schema": "^7.0.15",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "catalog:",
    "@types/spark-md5": "^3.0.5",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
