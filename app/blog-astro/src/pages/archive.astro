---
import * as stylex from "@stylexjs/stylex";
import { styles } from "@/styles/pages/archive.stylex";
import NavLayout from "@/components/layouts/NavLayout.astro";
import Section from "@/components/ui/section.astro";
import { getSortedPosts } from "@/lib/utils/content";
import { getSeo } from "@/lib/utils/SEO";
import type { CollectionEntry } from "astro:content";
import { format } from "date-fns";

const posts = await getSortedPosts();

const groupedPosts = posts.reduce<
  {
    year: string;
    posts: CollectionEntry<"post">[];
  }[]
>((acc, post) => {
  const year = format(post.data.publishedDate, "yyyy");
  const index = acc.findIndex((item) => item.year === year);
  if (index !== -1) {
    acc[index].posts.push(post);
  } else {
    acc.push({ year, posts: [post] });
  }
  return acc;
}, []);
groupedPosts.sort((a, b) => Number(b.year) - Number(a.year));

const seoConfig = getSeo({
  title: "归档",
  description: "文章归档",
  noindex: true,
});
---

<NavLayout seoConfig={seoConfig}>
  <Section styles={styles.hero} bg="grid">
    <div {...stylex.attrs(styles.heroContent)}>
      <h1 {...stylex.attrs(styles.title)}>归档</h1>
      <p {...stylex.attrs(styles.description)}>共有 {posts.length} 篇文章</p>
    </div>
  </Section>
  <Section styles={styles.section}>
    <div {...stylex.attrs(styles.archive)}>
      {
        groupedPosts.map((group) => (
          <div {...stylex.attrs(styles.group)}>
            <h2 {...stylex.attrs(styles.year)}>
              {group.year}{" "}
              <span {...stylex.attrs(styles.count)}>
                ({group.posts.length})
              </span>
            </h2>
            <ul {...stylex.attrs(styles.list)}>
              {group.posts.map((post) => (
                <li {...stylex.attrs(styles.row)}>
                  <span {...stylex.attrs(styles.entry)}>
                    <span {...stylex.attrs(styles.date)}>
                      {format(post.data.publishedDate, "MM/dd")}
                    </span>
                    <a {...stylex.attrs(styles.link)} href={`/post/${post.id}`}>
                      {post.data.title}
                    </a>
                  </span>
                  {/* <span class="hidden font-light text-xs lg:inline max-w-24 truncate">
                    {post.data.tags.map((tag) => `#${tag}`).join("/")}
                  </span> */}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>
</NavLayout>
