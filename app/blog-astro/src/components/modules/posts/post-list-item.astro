---
import * as stylex from "@stylexjs/stylex";
import type { CollectionEntry } from "astro:content";
import PostAttrTime from "./post-attr-time.astro";
import PostAttrTags from "./post-attr-tags.astro";
import { layout } from "@/styles/layout.stylex";
import { getDesc } from "@/lib/content/get-description";
import { renderExcerpt } from "@repo/markdown/excerpt";
import { styles } from "./post-list-item.stylex";

interface Props {
  post: CollectionEntry<"post">;
  class?: string;
  last?: boolean;
}

const { post, class: className, last = false } = Astro.props;

const excerptHtml = post.data.description
  ? undefined
  : await renderExcerpt(getDesc(post.body!));

const rootClass = stylex.attrs(
  layout.container,
  layout.queryContainer,
  layout.divider,
  styles.root,
  last && styles.lastItem,
).class;
---

<div class={`${rootClass}${className ? ` ${className}` : ""}`}>
  <div {...stylex.attrs(styles.content)}>
    <a href={`/post/${post.id}`}>
      <h2 {...stylex.attrs(styles.title)}>
        {post.data.title}
      </h2>
    </a>
    <div {...stylex.attrs(styles.attributes)}>
      <PostAttrTime {...post.data} />
      <PostAttrTags tags={post.data.tags} />
    </div>
    {
      post.data.description ? (
        <div class={`prose prose-theme ${stylex.attrs(styles.excerpt).class}`}>
          {post.data.description}
        </div>
      ) : (
        <div
          class={`prose prose-theme ${stylex.attrs(styles.excerpt).class}`}
          set:html={excerptHtml ?? ""}
        />
      )
    }
  </div>
</div>
