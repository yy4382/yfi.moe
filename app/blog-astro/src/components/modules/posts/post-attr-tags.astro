---
import * as stylex from "@stylexjs/stylex";
import { styles } from "./post-attr-tags.stylex";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div {...stylex.attrs(styles.root)}>
  <span class={`i-lucide-hash ${stylex.attrs(styles.icon).class}`}></span>
  <span>
    {
      tags.map((tag, index) => (
        <>
          {index !== 0 && (
            <span {...stylex.attrs(styles.item, styles.separator)}>|</span>
          )}
          <a href={`/tags/${tag}`} {...stylex.attrs(styles.item, styles.link)}>
            {tag}
          </a>
        </>
      ))
    }
  </span>
</div>
