---
import * as stylex from "@stylexjs/stylex";
import Section from "@/components/ui/section.astro";
import { styles } from "./list-hero.stylex";

interface Props {
  title: string;
  desc?: string;
}

const { title, desc } = Astro.props;
---

<Section styles={styles.section} padding="postList" bg="grid">
  <h1 {...stylex.attrs(styles.title)}>{title}</h1>
  {desc && <p {...stylex.attrs(styles.description)}>{desc}</p>}
</Section>
