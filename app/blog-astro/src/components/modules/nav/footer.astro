---
import * as stylex from "@stylexjs/stylex";
import { siteConfig, siteDomain } from "@/config/site";
import { Image } from "astro:assets";
import logo from "@/assets/logo.png";
import { layout } from "@/styles/layout.stylex";
import { styles } from "./footer.stylex";
---

<div {...stylex.attrs(layout.container, styles.root)}>
  <a href="/" {...stylex.attrs(styles.brand)}>
    <Image
      src={logo}
      alt="logo"
      width="32"
      height="32"
      {...stylex.attrs(styles.logo)}
    />
    Yunfi
  </a>
  <div {...stylex.attrs(styles.content)}>
    <ul {...stylex.attrs(styles.groups)}>
      <li>
        <span {...stylex.attrs(styles.groupTitle)}>
          关于
          <span
            class={`i-lucide-chevron-right ${stylex.attrs(styles.icon).class}`}
          ></span>
        </span>
        <span {...stylex.attrs(styles.links)}>
          <a href="/about">关于我</a>
          <a href="/about#关于本站">关于本站</a>
          <a href="https://github.com/yy4382/yfi.moe">本站源码</a>
        </span>
      </li>
      <li>
        <span {...stylex.attrs(styles.groupTitle)}>
          联系
          <span
            class={`i-lucide-chevron-right ${stylex.attrs(styles.icon).class}`}
          ></span>
        </span>
        <span {...stylex.attrs(styles.links)}>
          <button class="copy-email" data-email="yy4382@gmail.com"
            >发邮件</button
          >
          <a href="https://t.me/YunfiDiscuz">Telegram</a>
          <a href="https://github.com/yy4382">GitHub</a>
        </span>
      </li>
    </ul>
    <div {...stylex.attrs(styles.legal)}>
      <span {...stylex.attrs(styles.legalRow)}>
        <span {...stylex.attrs(styles.inlineGroup)}>
          <span class={`i-lucide-copyright ${stylex.attrs(styles.icon).class}`}
          ></span>
          2023-2024
          <span>
            <a href={siteDomain} {...stylex.attrs(styles.underline)}>
              {" "}{siteConfig.title}</a
            >.
          </span>
        </span>
        <span {...stylex.attrs(styles.mutedSeparator)}>|</span>
        <a href="/feed.xml" {...stylex.attrs(styles.inlineGroup)}>
          <span class={`i-lucide-rss ${stylex.attrs(styles.icon).class}`}
          ></span>
          RSS
        </a>
        <span {...stylex.attrs(styles.mutedSeparator)}>|</span>
        <a href="/sitemap-index.xml" {...stylex.attrs(styles.inlineGroup)}>
          <span class={`i-lucide-map ${stylex.attrs(styles.icon).class}`}
          ></span>
          Site Map
        </a>
      </span>
      <span {...stylex.attrs(styles.mutedText)}>
        Powered by{" "}
        <a href="https://astro.build" {...stylex.attrs(styles.underline)}>
          Astro</a
        >. See all{" "}
        <a href="/credits" {...stylex.attrs(styles.underline)}> Credits</a>.
      </span>
    </div>
  </div>
</div>

<script>
  import { toast } from "sonner";

  function initCopyEmail() {
    document.querySelectorAll(".copy-email").forEach((button) => {
      button.addEventListener("click", () => {
        const email = button.getAttribute("data-email");
        if (email) {
          navigator.clipboard
            .writeText(email)
            .then(() => {
              toast.success("复制邮箱成功");
            })
            .catch(() => {
              toast.error("复制失败，可能您没有使用 HTTPS 访问");
            });
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initCopyEmail);
</script>
