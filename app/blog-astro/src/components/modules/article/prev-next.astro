---
import * as stylex from "@stylexjs/stylex";
import { getAdjacentPosts } from "@/lib/utils/content";
import { layout } from "@/styles/layout.stylex";
import { groupMarker, styles } from "./prev-next.stylex";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const { prev, next } = await getAdjacentPosts(currentSlug);
---

{
  (prev || next) && (
    <div {...stylex.attrs(layout.divider)}>
      <div
        {...stylex.attrs(
          layout.container,
          styles.grid,
          prev && next ? styles.doubleGrid : styles.singleGrid,
        )}
      >
        {prev && (
          <div {...stylex.attrs(groupMarker, styles.cardContainer)}>
            <a
              {...stylex.attrs(styles.link, styles.previousLink)}
              href={`/post/${prev.id}`}
            >
              <div {...stylex.attrs(styles.iconCircle)}>
                <span
                  class={`i-lucide-chevron-left ${stylex.attrs(styles.icon).class}`}
                />
              </div>
              <div>
                <p {...stylex.attrs(styles.label)}>上一篇</p>
                <p {...stylex.attrs(styles.title)}>{prev.data.title}</p>
              </div>
            </a>
          </div>
        )}
        {next && (
          <div {...stylex.attrs(groupMarker, styles.cardContainer)}>
            <a
              {...stylex.attrs(styles.link, styles.nextLink)}
              href={`/post/${next.id}`}
            >
              <div {...stylex.attrs(styles.iconCircle)}>
                <span
                  class={`i-lucide-chevron-right ${stylex.attrs(styles.icon).class}`}
                />
              </div>
              <div {...stylex.attrs(styles.nextText)}>
                <p {...stylex.attrs(styles.label)}>下一篇</p>
                <p {...stylex.attrs(styles.title)}>{next.data.title}</p>
              </div>
            </a>
          </div>
        )}
      </div>
    </div>
  )
}
