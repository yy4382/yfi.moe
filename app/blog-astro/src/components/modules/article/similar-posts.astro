---
import * as stylex from "@stylexjs/stylex";
import { getSimilarPosts } from "@/lib/utils/content";
import { layout } from "@/styles/layout.stylex";
import { cardMarker, styles } from "./similar-posts.stylex";

interface Props {
  currentSlug: string;
  limit?: number;
}

const { currentSlug, limit = 3 } = Astro.props;
const similarPosts = await getSimilarPosts(currentSlug, limit);
---

{
  similarPosts.length > 0 && (
    <div {...stylex.attrs(layout.divider)}>
      <div {...stylex.attrs(layout.container)}>
        <div {...stylex.attrs(styles.headingContainer)}>
          <h2 {...stylex.attrs(styles.heading)}>相关推荐</h2>
        </div>
        <div {...stylex.attrs(styles.grid)}>
          {similarPosts.map(({ post }, index) => (
            <a
              href={`/post/${post.id}`}
              {...stylex.attrs(
                cardMarker,
                styles.card,
                index < similarPosts.length - 1 && styles.separatedCard,
              )}
            >
              <h3 {...stylex.attrs(styles.title)}>{post.data.title}</h3>
              {post.data.tags.length > 0 && (
                <div {...stylex.attrs(styles.tags)}>
                  <span
                    class={`i-lucide-hash ${stylex.attrs(styles.tagIcon).class}`}
                  />
                  <span>
                    {post.data.tags.slice(0, 3).map((tag, tagIndex) => (
                      <>
                        {tagIndex !== 0 && (
                          <span {...stylex.attrs(styles.tagPiece)}>|</span>
                        )}
                        <span
                          {...stylex.attrs(
                            styles.tagPiece,
                            tagIndex ===
                              Math.min(post.data.tags.length, 3) - 1 &&
                              styles.lastTagPiece,
                          )}
                        >
                          {tag}
                        </span>
                      </>
                    ))}
                  </span>
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  )
}
