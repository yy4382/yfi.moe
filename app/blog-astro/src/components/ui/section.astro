---
import * as stylex from "@stylexjs/stylex";
import { layout } from "@/styles/layout.stylex";
import { styles } from "./section.stylex";

interface Props {
  styles?: stylex.StyleXStyles;
  outerStyles?: stylex.StyleXStyles;
  containerStyles?: stylex.StyleXStyles;
  padding?: "sm" | "article" | "postList";
  bg?: "grid";
}

const {
  styles: innerStyles,
  outerStyles,
  containerStyles,
  padding,
  bg,
} = Astro.props;
const paddingStyles = {
  sm: styles.smallPadding,
  article: styles.articlePadding,
  postList: styles.postListPadding,
};
---

<section {...stylex.attrs(layout.divider, outerStyles)}>
  <div {...stylex.attrs(layout.container, styles.container, containerStyles)}>
    <div
      {...stylex.attrs(
        padding && paddingStyles[padding],
        bg === "grid" && layout.gridBackground,
        innerStyles,
      )}
    >
      <slot />
    </div>
  </div>
</section>
