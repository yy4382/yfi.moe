---
import * as stylex from "@stylexjs/stylex";
import { styles } from "./layouts.stylex";
import { layout } from "@/styles/layout.stylex";
import BaseLayout from "./BaseLayout.astro";
import Navbar from "@/components/modules/nav/navbar.astro";
import Footer from "@/components/modules/nav/footer.astro";

type Props = Parameters<typeof BaseLayout>[0];
---

<BaseLayout {...Astro.props}>
  <div {...stylex.attrs(styles.navigationSurface)}>
    <div {...stylex.attrs(styles.navigationGrid)}>
      <Navbar />
      <div {...stylex.attrs(styles.content)}>
        <slot />
      </div>
      <section
        {...stylex.attrs(layout.gridBackground, layout.divider, styles.spacer)}
      >
      </section>
      <Footer />
    </div>
  </div>
</BaseLayout>
